# Local development secrets for `wrangler dev`.
# Copy to `.dev.vars` and fill in real values. Never commit `.dev.vars`.

# --- Firestore (Google service account) ---
FIREBASE_PROJECT_ID=marketloop-rw
FIREBASE_CLIENT_EMAIL=your-service-account@marketloop-rw.iam.gserviceaccount.com
# Keep the key on a single line with literal \n escapes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvA...\n-----END PRIVATE KEY-----\n"
# Optional: override the Google JWKS endpoint (used by test-auth, local mock):
# FIREBASE_JWKS_URL=http://127.0.0.1:8798/jwks

# --- R2 presigned uploads (Custom S3 API credentials) ---
# Account ID: Cloudflare dashboard -> R2 -> "Account ID" (top-right).
# API token: R2 -> Manage R2 API Tokens -> create with Object Read & Write.
R2_BUCKET_NAME=marketloop-images

# --- Paypack (mobile money, RWF) ---
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
# Webhook secret used to verify X-Paypack-Signature (set the same value in Paypack's dashboard).
PAYPACK_WEBHOOK_SECRET=
# Optional overrides:
# PAYPACK_BASE_URL=https://api.paypack.ph
# PAYPACK_ENVIRONMENT=development

# --- Pesapal (cards, USD) ---
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional: pre-registered IPN id (otherwise registered once into Firestore on first order).
# PESAPAL_IPN_ID=
# PESAPAL_BASE_URL=https://pay.pesapal.com/v3

# --- Frontend ---
# Public origin used for Pesapal callbacks (/checkout/callback).
FRONTEND_URL=http://localhost:3000
