    "test:firestore": "tsx scripts/test-firestore.ts",
    "test:presign": "tsx scripts/test-presign.ts",
    "test:products": "tsx scripts/test-products.ts",
    "test:bids": "tsx scripts/test-bids.ts",
    "test:paypack": "tsx scripts/test-paypack.ts",
    "test:pesapal": "tsx scripts/test-pesapal.ts",
    "test:orders": "tsx scripts/test-orders.ts",
    "test:admin": "tsx scripts/test-admin.ts"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
